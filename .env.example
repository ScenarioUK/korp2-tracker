# Template only. Copy to .env for local development:
#   cp .env.example .env
#
# Local dev from cold, once .env exists:
#   npm run db:start     start the local Postgres (or: docker compose up -d)
#   npm run dev          build, migrate, seed and serve on PORT
#   npm run db:stop      shut the database down again
#
# Only `npm run dev` reads this file, via node --env-file-if-exists. `npm start`
# deliberately does not: in DigitalOcean the values below arrive as App Platform
# environment variables and no .env file exists.
#
# .env is gitignored and must never be committed. This file holds NO real
# values — every secret below is blank or a local-only placeholder.
#
# In DigitalOcean these are set as App Platform environment variables, with
# MCP_TOKEN and DATABASE_URL marked as encrypted secrets.

# App Platform sets PORT in production. 3000 is only the local fallback.
PORT=3000

# Postgres connection string.
# This default matches docker-compose.yml, so `docker compose up -d` and this
# line work together with nothing else to change.
# SSL is turned on automatically for any non-localhost host, which DigitalOcean
# managed Postgres requires; localhost is exempt.
DATABASE_URL=postgres://korp2:korp2_local_dev_only@localhost:5432/korp2_tracker

# Local-only password for the dev container. Not a secret — it guards a
# throwaway database on your own machine and is never used anywhere else.
# Change it here and in DATABASE_URL above if you prefer.
POSTGRES_PASSWORD=korp2_local_dev_only

# Optional: paste the DigitalOcean CA certificate to verify the server's
# certificate chain rather than only encrypting the connection.
# DATABASE_CA_CERT=

# Optional: "disable" turns SSL off entirely. Not normally needed — localhost
# is already exempt.
# DATABASE_SSL=disable

# Bearer token for POST /mcp. Minimum 24 characters; the app refuses to start
# with anything shorter. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# In Claude this goes in the custom connector's request headers as:
#   Authorization: Bearer <value>
# Never put it in a URL or a query string.
MCP_TOKEN=

# Not used yet — reserved for the UI in a later build step.
# UI_TOKEN=
