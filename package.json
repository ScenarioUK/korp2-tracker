{
  "name": "korp2-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "KORP2 Iteration 1 delivery tracker — MCP endpoint and (later) UI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsc && node --env-file-if-exists=.env --enable-source-maps dist/src/index.js",
    "dev:ui": "vite",
    "build": "tsc && tsc -p ui --noEmit && vite build",
    "start": "node dist/src/index.js",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "db:start": "node scripts/pg.mjs start",
    "db:stop": "node scripts/pg.mjs stop",
    "db:status": "node scripts/pg.mjs status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
